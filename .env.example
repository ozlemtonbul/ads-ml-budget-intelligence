# ============================================================
# GOOGLE ADS
# ============================================================

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=


# ============================================================
# GOOGLE ANALYTICS 4 (GA4)
# ============================================================

GA4_PROPERTY_ID=

# Path to the Google Analytics 4 service account JSON file.
GA4_SERVICE_ACCOUNT_FILE=./credentials/ga4_service_account.json


# ============================================================
# DATE RANGE
# ============================================================

# Supported values:
# custom
# yesterday
# last_30_days
# last_60_days

DATE_MODE=last_60_days

# Required only when DATE_MODE=custom.
DATE_FROM=
DATE_TO=


# ============================================================
# BUSINESS TARGET
# ============================================================

TARGET_ROAS=3.0


# ============================================================
# LARGE LANGUAGE MODEL (LLM)
# ============================================================

# Supported providers:
# anthropic
# openai
# gemini
#
# LLM_ENABLED=false keeps live LLM API calls disabled.
# Deterministic analytics remain available.

LLM_ENABLED=false
LLM_PROVIDER=anthropic

# Enter the model that belongs to the selected provider.
#
# Anthropic:
# claude-sonnet-4-6
#
# OpenAI:
# gpt-5.1
#
# Gemini:
# gemini-2.5-pro

LLM_MODEL=claude-sonnet-4-6

# Default language used for LLM-generated content.
LLM_LANGUAGE=en

# Maximum number of campaigns included in an LLM request.
LLM_MAX_CAMPAIGNS=20

# Maximum output tokens allowed for a single live LLM request.
# The LLM manager enforces this as a hard upper limit.
LLM_MAX_TOKENS=800

# Maximum number of live LLM API requests allowed per day.
# Once the limit is reached, no additional provider call is made
# and the application can continue with deterministic fallback logic.
LLM_DAILY_REQUEST_LIMIT=20

# Local file used to store the daily LLM request counter.
# outputs/ is excluded from the public repository.
LLM_USAGE_FILE=./outputs/llm_usage.json

# LLM generation temperature.
LLM_TEMPERATURE=0.2


# ============================================================
# LLM API KEYS
# ============================================================

# Fill in only the API key for the selected provider.
# Leave the remaining provider keys empty.
#
# Never commit real API keys to GitHub.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=


# ============================================================
# OUTPUT
# ============================================================

# Both names are supported.
# VICCO_OUTPUT_DIR takes precedence over OUTPUT_DIR.

OUTPUT_DIR=./outputs
VICCO_OUTPUT_DIR=./outputs


# ============================================================
# POSTGRESQL
# ============================================================

POSTGRES_ENABLED=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ads_budget
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Supported values:
# replace
# append
# fail

POSTGRES_IF_EXISTS=replace